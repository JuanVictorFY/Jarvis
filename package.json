{
  "name": "jarvis",
  "displayName": "Jarvis",
  "description": "Autonomous AI desktop agent powered by Claude",
  "version": "0.2.0",
  "author": "JuanVictorFY",
  "license": "MIT",
  "main": "out/main.js",
  "scripts": {
    "postinstall": "node scripts/generate-icon.js",
    "start": "electron .",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "dev": "npm run compile && electron .",
    "build": "npm run compile && electron-builder"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.3",
    "puppeteer-core": "^23.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.3.0"
  },
  "build": {
    "appId": "com.juanvictorfy.jarvis",
    "productName": "Jarvis",
    "directories": { "output": "dist" },
    "files": ["out/**/*", "renderer/**/*", "assets/**/*"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    }
  }
}
